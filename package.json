{
  "name": "heatgate-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HeatGate: Heat-safety rules for delivery riders",
  "workspaces": [
    "contracts",
    "engine",
    "sim",
    "api",
    "web"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p engine && tsc -p sim && tsc -p api",
    "check-policies": "tsx scripts/check-policies.ts",
    "export-messages": "tsx scripts/export-messages.ts",
    "fetch-weather": "tsx scripts/fetch-weather.ts",
    "sim:full": "tsx sim/scripts/full.ts",
    "sim:sensitivity": "tsx sim/scripts/sensitivity.ts",
    "sim:breakeven": "tsx sim/scripts/breakeven.ts",
    "smoke": "tsx api/scripts/smoke.ts",
    "deploy:web": "tsx scripts/deploy-web.ts"
  },
  "keywords": [
    "cedar",
    "policy",
    "safety",
    "gig-economy",
    "heatwave"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
